{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "storage": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "s3",
            "filesystem"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "objectStoragePodSelector": {
          "type": "object"
        },
        "additionalEgressCIDRs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cidr",
              "ports"
            ],
            "properties": {
              "cidr": {
                "type": "string",
                "minLength": 1
              },
              "ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "storage",
          "networkPolicy"
        ],
        "properties": {
          "storage": {
            "required": [
              "backend"
            ],
            "properties": {
              "backend": {
                "const": "s3"
              }
            }
          },
          "networkPolicy": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "networkPolicy": {
                "required": [
                  "objectStoragePodSelector"
                ],
                "properties": {
                  "objectStoragePodSelector": {
                    "type": "object",
                    "minProperties": 1
                  }
                }
              }
            }
          },
          {
            "properties": {
              "networkPolicy": {
                "required": [
                  "additionalEgressCIDRs"
                ],
                "properties": {
                  "additionalEgressCIDRs": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          }
        ]
      }
    }
  ]
}
