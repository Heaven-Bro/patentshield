# Local development only. Copy this file to .env and rotate all values before
# using real patent material or deploying outside a disposable local instance.
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Docker Compose connection strings use service names. For native local Django,
# change DATABASE_URL host from postgres to 127.0.0.1 and REDIS host to localhost.
DATABASE_URL=postgresql://patentshield:change-me-local-only@postgres:5432/patentshield
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

POSTGRES_DB=patentshield***
POSTGRES_USER=patentshield***
POSTGRES_PASSWORD=change-me-local-only

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Keep external disclosure disabled until each tenant has approved the policy.
PATENTSHIELD_EXTERNAL_SEARCH_ENABLED=False
PATENTSHIELD_EXTERNAL_SEARCH_ALLOW_QUERY_DISCLOSURE=False
PATENTSHIELD_EXTERNAL_SEARCH_ALLOW_ALL_TENANTS=False
PATENTSHIELD_EXTERNAL_SEARCH_ALLOWED_TENANTS=
PATENTSHIELD_EXTERNAL_QUERY_HASH_KEY=replace-with-independent-random-audit-hmac-key
USPTO_ODP_API_KEY=
TAVILY_API_KEY=
PATENTSHIELD_ALLOW_MOCK_EMBEDDINGS=True
PATENTSHIELD_MAX_PDF_UPLOAD_BYTES=104857600
PATENTSHIELD_BUILD_ML_WORKER=0

# Optional frontend identity configuration for local read-only integration.
VITE_API_BASE_URL=http://localhost:8000
VITE_TENANT_ID=
VITE_PATENT_ID=
VITE_ANALYSIS_ID=
