# Local development template only; production must use deployment-managed configuration.
# Never commit a populated .env file or copy this template unchanged to production.
# Generate unique secrets locally; do not reuse these placeholder values.
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api

# Values here are examples for Docker Compose. Keep DATABASE_URL credentials
# synchronized with POSTGRES_USER and POSTGRES_PASSWORD below.
POSTGRES_DB=patentshield
POSTGRES_USER=patentshield
POSTGRES_PASSWORD=replace-with-a-unique-database-password
DATABASE_URL=postgresql://patentshield:replace-with-a-unique-database-password@postgres:5432/patentshield
DB_CONN_MAX_AGE=60

REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CHANNELS_REDIS_URL=redis://redis:6379/4
CELERY_TASK_TIME_LIMIT=1800
CELERY_TASK_SOFT_TIME_LIMIT=1500

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
SESSION_EXPIRE_AT_BROWSER_CLOSE=False
PATENTSHIELD_LOGIN_RATE=10/min

# External disclosure is disabled by default. Enable only after tenant policy
# and source licensing have been reviewed. The HMAC key must be independent
# from DJANGO_SECRET_KEY and must contain at least 32 random characters.
PATENTSHIELD_EXTERNAL_SEARCH_ENABLED=False
PATENTSHIELD_EXTERNAL_SEARCH_ALLOW_QUERY_DISCLOSURE=False
PATENTSHIELD_EXTERNAL_SEARCH_ALLOW_ALL_TENANTS=False
PATENTSHIELD_EXTERNAL_SEARCH_ALLOWED_TENANTS=
PATENTSHIELD_EXTERNAL_QUERY_HASH_KEY=replace-with-a-separate-random-hmac-key-at-least-32-characters
USPTO_ODP_API_KEY=
TAVILY_API_KEY=

# Phase 5 — OpenAI-compatible Meta endpoint. Patent AI LLM features remain disabled
# until both the API key and base URL are provided. The base URL should be the API
# root (for example, https://provider.example/v1), not the /chat/completions path.
META_LLM_ENABLED=False
META_LLM_API_KEY=
META_LLM_BASE_URL=
META_LLM_MODEL=Muse Spark 1.3
META_LLM_TIMEOUT_SECONDS=60
# Keep false unless your organization has approved sending invention disclosures,
# private patent claims, and chat history to the configured external LLM provider.
META_LLM_ALLOW_SENSITIVE_DATA=False

# Development mock embeddings are forbidden when DJANGO_DEBUG=False.
PATENTSHIELD_ALLOW_MOCK_EMBEDDINGS=False
PATENTSHIELD_MAX_PDF_UPLOAD_BYTES=104857600
# Phase 6 — product FTO specification upload limit (must not exceed the global PDF cap).
PATENTSHIELD_FTO_MAX_UPLOAD_BYTES=31457280
# Set to 1 to install optional sentence-transformers/PyTorch in both API and worker images.
PATENTSHIELD_BUILD_ML_WORKER=0
# Set true to preload BAAI/bge-large-en-v1.5 in each API process; otherwise load on first use.
PATENTSHIELD_PUBLIC_PATENT_EMBEDDING_PRELOAD_ON_STARTUP=False
PATENTSHIELD_PUBLIC_PATENT_EMBEDDING_BATCH_SIZE=32
PATENTSHIELD_PUBLIC_PATENT_EMBEDDING_MODEL_NAME=BAAI/bge-large-en-v1.5
PATENTSHIELD_PUBLIC_PATENT_EMBEDDING_REVISION=REPLACE_WITH_IMMUTABLE_40_OR_64_HEX_COMMIT_ID # copy exact revision from signed model-bundle manifest
PATENTSHIELD_PUBLIC_PATENT_EMBEDDING_DEVICE=
PATENTSHIELD_PUBLIC_PATENT_EMBEDDING_LOCAL_FILES_ONLY=False
PATENTSHIELD_PUBLIC_PATENT_EMBEDDING_CACHE_DIR=
PATENTSHIELD_MODEL_BUNDLE_MANIFEST=
PATENTSHIELD_INSTALLED_MODELS_DIR=./offline/installed-models
MEDIA_ROOT=/app/media
LOG_LEVEL=INFO

# Browser API URL belongs in frontend/.env, not in this backend environment.

# Phase 1 — official patent-data connectors. Keep credentials empty until enabled.
PATENTSHIELD_USPTO_API_URL=https://api.uspto.gov/api/v1/patent/applications/search
PATENTSHIELD_USPTO_MIN_INTERVAL_SECONDS=1.0
EPO_OPS_CLIENT_ID=
EPO_OPS_CLIENT_SECRET=
PATENTSHIELD_EPO_OPS_BASE_URL=https://ops.epo.org/3.2/rest-services
PATENTSHIELD_EPO_OPS_TOKEN_URL=https://ops.epo.org/3.2/auth/accesstoken
PATENTSHIELD_EPO_MIN_INTERVAL_SECONDS=6.0
PATENTSHIELD_CONNECTOR_SYNC_ENABLED=False

# Phase 3 — competitor surveillance and notification delivery (disabled by default).
PATENTSHIELD_SURVEILLANCE_ENABLED=False
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable and store it in the deployment secret manager; do not rotate without re-encrypting saved destinations.
PATENTSHIELD_SURVEILLANCE_ENCRYPTION_KEY=
# Exact DNS hostnames only; webhook destinations outside this allowlist are rejected.
PATENTSHIELD_SURVEILLANCE_WEBHOOK_ALLOWED_HOSTS=hooks.slack.com
PATENTSHIELD_SURVEILLANCE_MAX_RESULTS=10
PATENTSHIELD_SURVEILLANCE_MAX_DELIVERY_ATTEMPTS=6

# Phase 5 — on-demand translation. Keep disabled until privacy/legal review and
# explicit tenant approval are complete. Use a self-hosted provider where possible.
PATENTSHIELD_TRANSLATION_ENABLED=False
PATENTSHIELD_TRANSLATION_URL=
PATENTSHIELD_TRANSLATION_API_KEY=
PATENTSHIELD_TRANSLATION_ALLOWED_TENANTS=
PATENTSHIELD_TRANSLATION_ENGINE_VERSION=configured-v1
PATENTSHIELD_TRANSLATION_TIMEOUT_SECONDS=15
PATENTSHIELD_TRANSLATION_MAX_INPUT_CHARS=8000
PATENTSHIELD_TRANSLATION_MAX_OUTPUT_CHARS=30000

# Phase 8 — enterprise OIDC/SAML/SCIM. Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PATENTSHIELD_ENTERPRISE_ENCRYPTION_KEY=
# Exact host allowlist for OIDC discovery/token/JWKS and SAML SSO endpoints; required in production.
PATENTSHIELD_IDP_ALLOWED_HOSTS=login.example.com,accounts.example.com
PATENTSHIELD_OIDC_CALLBACK_URL=https://patentshield.example.com/api/v1/enterprise-auth/oidc/callback/
# SAML base URLs must include the /api/v1/enterprise-auth/saml prefix.
PATENTSHIELD_SAML_ACS_BASE_URL=https://patentshield.example.com/api/v1/enterprise-auth/saml
PATENTSHIELD_SAML_METADATA_BASE_URL=https://patentshield.example.com/api/v1/enterprise-auth/saml
PATENTSHIELD_SSO_SUCCESS_URL=/
PATENTSHIELD_SCIM_MAX_PAGE_SIZE=100
# Cross-site SAML POST responses require SameSite=None in production: set SESSION_COOKIE_SAMESITE=None.

# Phase 9 — private-cloud/air-gapped deployment.
# Import these exact digest-pinned images into the private registry before Docker Compose starts.
# The Compose runtime uses pull_policy=never and does not mount application source code.
PATENTSHIELD_BACKEND_IMAGE=registry.internal.example/patentshield-api@sha256:REPLACE_WITH_64_HEX_DIGEST
PATENTSHIELD_FRONTEND_IMAGE=registry.internal.example/patentshield-frontend@sha256:REPLACE_WITH_64_HEX_DIGEST
PATENTSHIELD_POSTGRES_IMAGE=registry.internal.example/pgvector@sha256:REPLACE_WITH_64_HEX_DIGEST
PATENTSHIELD_REDIS_IMAGE=registry.internal.example/redis@sha256:REPLACE_WITH_64_HEX_DIGEST
# In air-gapped Kubernetes, the Helm chart enforces these values and a default-deny
# egress NetworkPolicy. Keep the API/worker model paths read-only.
PATENTSHIELD_OFFLINE_MODE=False
PATENTSHIELD_BGE_MODEL_PATH=
PATENTSHIELD_RERANKER_MODEL_PATH=
# `filesystem` preserves the default local backend; `s3` requires django-storages[s3].
PATENTSHIELD_STORAGE_BACKEND=filesystem
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_VERIFY=true
# Production S3 mode requires SSE-KMS and an operator-managed CMK/key alias.
PATENTSHIELD_OBJECT_STORAGE_SSE=aws:kms
PATENTSHIELD_OBJECT_STORAGE_KMS_KEY_ID=
# AWS_S3_ACCESS_KEY_ID / AWS_S3_SECRET_ACCESS_KEY are supplied by a secret manager;
# prefer workload identity/instance roles where supported by the private platform.
# BGE-M3 multilingual embedding (FlagEmbedding; local paths are for air-gapped bundles)
BGE_MODEL_NAME=BAAI/bge-m3
PATENTSHIELD_BGE_MODEL_REVISION=REPLACE_WITH_IMMUTABLE_40_OR_64_HEX_COMMIT_ID
PATENTSHIELD_BGE_BATCH_SIZE=32
PATENTSHIELD_BGE_MAX_LENGTH=8192
PATENTSHIELD_BGE_USE_FP16=false
PATENTSHIELD_BGE_DEVICE=
PATENTSHIELD_MODEL_CACHE_DIR=
PATENTSHIELD_TEXT_EMBEDDING_BATCH_SIZE=32
# Multilingual BGE reranker (FlagEmbedding)
PATENTSHIELD_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
PATENTSHIELD_RERANKER_MODEL_REVISION=REPLACE_WITH_IMMUTABLE_40_OR_64_HEX_COMMIT_ID
PATENTSHIELD_RERANKER_BATCH_SIZE=16
PATENTSHIELD_RERANKER_QUERY_MAX_LENGTH=256
PATENTSHIELD_RERANKER_MAX_LENGTH=512
PATENTSHIELD_RERANKER_USE_FP16=false
PATENTSHIELD_RERANKER_DEVICE=
PATENTSHIELD_META_LLM_CONTEXT_MAX_CHARS=60000
PATENTSHIELD_CELERY_WORKER_CONCURRENCY=2
PATENTSHIELD_EMBEDDING_WORKER_CONCURRENCY=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=25

# Shared PDF extraction / OCR / schematic resource limits
PATENTSHIELD_PDF_MAX_BYTES=104857600
PATENTSHIELD_PDF_MAX_PAGES=2000
PATENTSHIELD_PDF_MAX_TEXT_CHARS=25000000
PATENTSHIELD_PDF_OCR_MIN_PAGE_CHARS=40
PATENTSHIELD_PDF_MAX_OCR_PAGES=250
PATENTSHIELD_PDF_MAX_RENDER_PIXELS=24000000
PATENTSHIELD_PDF_OCR_PAGE_TIMEOUT_SECONDS=30
PATENTSHIELD_PDF_TOTAL_TIMEOUT_SECONDS=900
PATENTSHIELD_PDF_OCR_LANGUAGE=eng
PATENTSHIELD_TESSERACT_BINARY=tesseract
PATENTSHIELD_PDF_MAX_SCHEMATICS=200
PATENTSHIELD_PDF_SCHEMATIC_MAX_PIXELS=8000000
PATENTSHIELD_PDF_SCHEMATIC_MAX_BYTES=20971520
PATENTSHIELD_PDF_SCHEMATIC_TIMEOUT_SECONDS=600

# TenantExternalAIProcessingPolicy must also approve translation data categories.
PATENTSHIELD_TRANSLATION_MAX_RESPONSE_BYTES=1048576


# Maximum tenant-scoped chunk corpus loaded into per-request BM25 memory.
PATENTSHIELD_BM25_MAX_CHUNKS=2500
