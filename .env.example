# Local development values only. Use a proper secret manager and strong secrets outside local development.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-development-secret
DJANGO_DEBUG=True

# Inside Docker, use the Compose service names: postgres and redis.
DATABASE_URL=postgresql://patentshield:change-me-local-only@postgres:5432/patentshield
REDIS_URL=redis://redis:6379/0

POSTGRES_DB=patentshield
POSTGRES_USER=patentshield
POSTGRES_PASSWORD=change-me-local-only
